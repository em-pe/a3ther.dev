---
import Base from '../layouts/Base.astro';

const title = 'Mateusz Pytel — Data & AI Architect';
const description =
  'I design and build the connective medium that carries data, models and decisions from prototype to production. Connected once, maintained by design.';
---

<Base title={title} description={description}>
  <main>
    <article>
      <div class="lockup" aria-label="AETHER">
        <svg
          class="mark"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 256 256"
          width="40"
          height="40"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <clipPath id="diag">
              <polygon points="0,256 256,256 256,40" />
            </clipPath>
            <linearGradient id="p" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#14A57A" />
              <stop offset="26%" stop-color="#1BA6B0" />
              <stop offset="58%" stop-color="#2AA6D8" />
              <stop offset="82%" stop-color="#1E7AD0" />
              <stop offset="100%" stop-color="#1E6AD0" />
            </linearGradient>
            <linearGradient id="fade" gradientUnits="userSpaceOnUse" x1="0" y1="256" x2="256" y2="40">
              <stop offset="0" style="stop-color: var(--mark-ink); stop-opacity: 0" />
              <stop offset="0.22" style="stop-color: var(--mark-ink); stop-opacity: 0.6" />
              <stop offset="0.78" style="stop-color: var(--mark-ink); stop-opacity: 0.6" />
              <stop offset="1" style="stop-color: var(--mark-ink); stop-opacity: 0" />
            </linearGradient>
          </defs>
          <text x="50%" y="52%" dominant-baseline="central" text-anchor="middle" font-size="150" style="fill: var(--mark-ink)">Æ</text>
          <g clip-path="url(#diag)">
            <text x="50%" y="52%" dominant-baseline="central" text-anchor="middle" font-size="150" fill="url(#p)">Æ</text>
          </g>
          <line x1="0" y1="256" x2="256" y2="40" stroke="url(#fade)" stroke-width="1.4" />
        </svg>
        <span class="wordmark">AETHER</span>
      </div>

      <h1>Mateusz Pytel</h1>
      <p class="eyebrow">Data &amp; AI Architect</p>

      <p class="lead">
        I design and build the connective medium that carries data, models and decisions from prototype
        to production. Connected once, maintained by design.
      </p>

      <p class="body">
        Cloud data and ML platforms on Google Cloud and Kubernetes. Secure by default. Compliance,
        PII controls and auditability — proven in banking, insurance and fintech. Everything as code,
        built with your team and handed off to run on its own. MLOps, GenAI and agentic systems —
        tested, monitored and measured.
      </p>

      <p class="body">
        15 years in data and AI · 8 as a consultant architect. Remote-first, Kraków · Poland.
      </p>

      <p class="stack" aria-label="Stack">
        Google Cloud · Kubernetes · MLOps · GenAI · Agentic
      </p>

      <nav class="contact" aria-label="Contact">
        <a
          class="icon-button"
          href="mailto:hello@a3ther.dev"
          aria-label="hello@a3ther.dev"
          title="hello@a3ther.dev"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
        <a
          class="icon-button"
          href="https://www.linkedin.com/in/em-pe/"
          aria-label="LinkedIn"
          title="LinkedIn"
          rel="noopener"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        {/*
          GitHub button — hidden for now; re-enable by removing this comment.
          <a class="icon-button" href="https://github.com/em-pe" aria-label="GitHub" title="GitHub" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        */}
      </nav>
    </article>
    <div class="hairline" aria-hidden="true"></div>
  </main>
</Base>

<style>
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-7) var(--gutter) var(--space-8);
    background-image: var(--field-glow);
    background-repeat: no-repeat;
  }

  article {
    width: 100%;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .mark {
    display: block;
    width: 40px;
    height: 40px;
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: 16px;
    letter-spacing: var(--tracking-wordmark);
    color: var(--text-strong);
    line-height: 1;
  }

  h1 {
    margin: var(--space-7) 0 0;
    font-family: var(--font-display);
    font-weight: var(--weight-semibold);
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--text-strong);
  }

  .eyebrow {
    margin: var(--space-4) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--signal);
  }

  .lead {
    margin: var(--space-6) 0 0;
    font-family: var(--font-oracular);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(20px, 3vw, 24px);
    line-height: 1.45;
    color: var(--text-strong);
    text-wrap: pretty;
  }

  .body {
    margin: 28px 0 0;
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .body + .body {
    margin-top: var(--space-5);
  }

  .stack {
    margin: 28px 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    line-height: var(--leading-normal);
    color: var(--text-faint);
  }

  .contact {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: 28px;
    border-top: 1px solid var(--border);
    width: 100%;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .icon-button:hover {
    color: var(--signal);
    border-color: rgba(30, 122, 208, 0.4);
    transform: translateY(-2px);
  }

  .icon-button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* Bottom prism hairline: refraction gradient with transparent ends. */
  .hairline {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      rgba(20, 165, 122, 0) 0%,
      var(--prism-green) 18%,
      var(--prism-aqua) 38%,
      var(--prism-cyan) 55%,
      var(--prism-blue) 78%,
      rgba(30, 106, 208, 0) 100%
    );
    pointer-events: none;
  }
</style>
